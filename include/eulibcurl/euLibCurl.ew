end function

public function curl_maprintf(sequence text)
    atom tp = allocate_string(text)
    atom rp = c_func(fn_maprintf, {FMT_STR_PTR, tp})
    free(tp)
    if rp = 0 then
        return ""
    end if
    sequence res = peek_string(rp)
    curl_free(rp)
    return res
end function

public function curl_mvprintf(sequence fmt, atom va_args_ptr = 0)
    atom fp = allocate_string(fmt)
    integer rc = c_func(fn_mvprintf, {fp, va_args_ptr})
    free(fp)
    return rc
end function

public function curl_mvfprintf(atom c_file_ptr, sequence fmt, atom va_args_ptr = 0)
    atom fp = allocate_string(fmt)
    integer rc = c_func(fn_mvfprintf, {c_file_ptr, fp, va_args_ptr})
    free(fp)
    return rc
end function

public function curl_mvsprintf(atom out_buf, sequence fmt, atom va_args_ptr = 0)
    atom fp = allocate_string(fmt)
    integer rc = c_func(fn_mvsprintf, {out_buf, fp, va_args_ptr})
    free(fp)
    return rc
end function

public function curl_mvsnprintf(atom out_buf, atom max_len, sequence fmt, atom va_args_ptr = 0)
    atom fp = allocate_string(fmt)
    integer rc = c_func(fn_mvsnprintf, {out_buf, max_len, fp, va_args_ptr})
    free(fp)
    return rc
end function

public function curl_mvaprintf(sequence fmt, atom va_args_ptr = 0)
    atom fp = allocate_string(fmt)
    atom rp = c_func(fn_mvaprintf, {fp, va_args_ptr})
    free(fp)
    if rp = 0 then
        return ""
    end if
    sequence res = peek_string(rp)
    curl_free(rp)
    return res
end function

-- =============================================================================
-- 13. Modern Synchronous Helpers
-- =============================================================================

map perform_ex_buffers = map:new()

function easy_ex_write_cb(atom bufferp, atom size, atom nmemb, atom curl)
    atom total = size * nmemb
    if total > 0 then
        sequence chunk = peek({bufferp, total})
        sequence prev = map:get(perform_ex_buffers, curl, "")
        map:put(perform_ex_buffers, curl, prev & chunk)
    end if
    return total
end function

constant EASY_EX_WRITE_CB = curl_callback(routine_id("easy_ex_write_cb"))

--**
-- Performs a synchronous transfer, capturing the response body per handle.
-- Returns {CURLcode, response_body}.
public function curl_easy_perform_ex(atom curl)
    map:put(perform_ex_buffers, curl, "")

    integer rc = curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, EASY_EX_WRITE_CB)
    if rc != CURLE_OK then
        map:remove(perform_ex_buffers, curl)
        return {rc, ""}
    end if

    rc = curl_easy_setopt(curl, CURLOPT_WRITEDATA, curl)
    if rc != CURLE_OK then
        map:remove(perform_ex_buffers, curl)
        return {rc, ""}
    end if

    rc = curl_easy_perform(curl)
    sequence body = map:get(perform_ex_buffers, curl, "")
    map:remove(perform_ex_buffers, curl)

    return {rc, body}
end function

--**
-- Synchronously downloads a URL into memory or directly to a file on disk.
-- If filename != "", writes to the file and returns CURLcode.
-- If filename = "", returns {CURLcode, body}.
public function curl_easy_get_file(sequence url, sequence proxy = "", sequence filename = "")
    atom curl = curl_easy_init()
    if curl = 0 then
        if length(filename) > 0 then
            return CURLE_FAILED_INIT
        end if
        return {CURLE_FAILED_INIT, ""}
    end if

    integer rc = curl_easy_setopt(curl, CURLOPT_URL, url)
    if rc = CURLE_OK and length(proxy) > 0 then
        rc = curl_easy_setopt(curl, CURLOPT_PROXY, proxy)
    end if
    if rc = CURLE_OK then
        rc = curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1)
    end if
    ifdef WINDOWS then
        if rc = CURLE_OK then
            rc = curl_easy_setopt(curl, CURLOPT_SSL_OPTIONS, CURLSSLOPT_NATIVE_CA)
        end if
    end ifdef

    if rc != CURLE_OK then
        curl_easy_cleanup(curl)
        if length(filename) > 0 then
            return rc
        end if
        return {rc, ""}
    end if

    sequence res = curl_easy_perform_ex(curl)
    curl_easy_cleanup(curl)

    rc = res[1]
    if rc != CURLE_OK then
        if length(filename) > 0 then
            return rc
        end if
        return res
    end if

    if length(filename) > 0 then
        integer fn = open(filename, "wb")
        if fn = -1 then
            return CURLE_CANT_OPEN_FILE
        end if
        puts(fn, res[2])
        close(fn)
        return CURLE_OK
    end if

    return res
end function

--**
-- Converts two 32-bit integers/atoms (little-endian: lo, hi) into an IEEE-754 double.
public function atoms_to_double(atom lo, atom hi)
    return float64_to_atom(int_to_bytes(lo) & int_to_bytes(hi))
end function
