--**
-- Sets MIME part data while preserving binary bytes (including embedded NUL bytes).
public function curl_mime_data(atom part, sequence data)
    integer n = length(data)
    atom p = allocate(n + 1)
    if n > 0 then
        poke(p, data)
    end if
    poke(p + n, 0)
    integer rc = c_func(fn_mime_data, {part, p, n})
    free(p)
    return rc
end function

