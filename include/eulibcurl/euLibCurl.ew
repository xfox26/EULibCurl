constant
    fn_easy_init        = cdecl_link_func("curl_easy_init", {}, C_POINTER),
    pr_easy_cleanup     = cdecl_link_proc("curl_easy_cleanup", {C_POINTER}),
    fn_easy_setopt_long = cdecl_link_func("curl_easy_setopt", {C_POINTER, C_INT, C_LONG}, C_INT),
    fn_easy_setopt_ptr  = cdecl_link_func("curl_easy_setopt", {C_POINTER, C_INT, C_POINTER}, C_INT),
    fn_easy_setopt_offt = cdecl_link_func("curl_easy_setopt", {C_POINTER, C_INT, C_LONGLONG}, C_INT),
    fn_easy_perform     = cdecl_link_func("curl_easy_perform", {C_POINTER}, C_INT),
    fn_easy_getinfo     = cdecl_link_func("curl_easy_getinfo", {C_POINTER, C_INT, C_POINTER}, C_INT),
    pr_easy_reset       = cdecl_link_proc("curl_easy_reset", {C_POINTER}),
    fn_easy_duphandle   = cdecl_link_func("curl_easy_duphandle", {C_POINTER}, C_POINTER),
    fn_easy_pause       = cdecl_link_func("curl_easy_pause", {C_POINTER, C_INT}, C_INT),
    fn_easy_escape      = cdecl_link_func("curl_easy_escape", {C_POINTER, C_POINTER, C_INT}, C_POINTER),
    fn_easy_unescape    = cdecl_link_func("curl_easy_unescape", {C_POINTER, C_POINTER, C_INT, C_POINTER}, C_POINTER),
    fn_easy_recv        = cdecl_link_func("curl_easy_recv", {C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_easy_send        = cdecl_link_func("curl_easy_send", {C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_easy_strerror    = cdecl_link_func("curl_easy_strerror", {C_INT}, C_POINTER),
    fn_easy_upkeep      = cdecl_link_func("curl_easy_upkeep", {C_POINTER}, C_INT),
    fn_easy_ssls_export = cdecl_link_func("curl_easy_ssls_export", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_easy_ssls_import = cdecl_link_func("curl_easy_ssls_import",
        {C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT)

public function curl_easy_init()
    return c_func(fn_easy_init, {})
end function

public procedure curl_easy_cleanup(atom curl)
    if curl != 0 then
        c_proc(pr_easy_cleanup, {curl})
        free_all_handle_allocs(curl)
    end if
end procedure

public procedure curl_easy_reset(atom curl)
    if curl != 0 then
        c_proc(pr_easy_reset, {curl})
        free_all_handle_allocs(curl)
    end if
end procedure

public function curl_easy_duphandle(atom curl)
    return c_func(fn_easy_duphandle, {curl})
end function

--**
-- Sets options on an Easy Handle, dispatching according to the option type:
-- LONG (<10000), OBJECT/STRING/CB/SLIST (10000..29999), 64-bit OFF_T (30000..39999),
-- and BLOB (>=40000, automatically packing a sequence into struct curl_blob).
public function curl_easy_setopt(atom curl, integer opt, object param)
    if opt >= 30000 and opt < 40000 then
        if sequence(param) then
            error:crash("OFF_T option (%d) expects a number (atom), not a sequence", {opt})
        end if
        return c_func(fn_easy_setopt_offt, {curl, opt, param})
    end if

    if opt >= 40000 and opt < 50000 then
        if sequence(param) then
            integer blen = length(param)
            atom data_ptr = 0
            if blen > 0 then
                data_ptr = allocate(blen)
                poke(data_ptr, param)
            end if
            atom blob_ptr = allocate(SIZEOF_CURL_BLOB)
            poke_pointer(blob_ptr, data_ptr)
            poke_pointer(blob_ptr + PTR_SIZE, blen)
            poke4(blob_ptr + (PTR_SIZE * 2), CURL_BLOB_COPY)

            integer rc = c_func(fn_easy_setopt_ptr, {curl, opt, blob_ptr})
            free(blob_ptr)
            if data_ptr != 0 then
                free(data_ptr)
            end if
            return rc
        end if
        return c_func(fn_easy_setopt_ptr, {curl, opt, param})
    end if

    if opt < 10000 then
        if sequence(param) then
            error:crash("LONG option (%d) expects a number (atom/integer), not a sequence", {opt})
        end if
        return c_func(fn_easy_setopt_long, {curl, opt, param})
    end if

    if sequence(param) then
        if opt = CURLOPT_POSTFIELDS then
            atom p = alloc_bytes_cstr(param)
            set_handle_opt_alloc(curl, opt, p)
            return c_func(fn_easy_setopt_ptr, {curl, opt, p})
        end if
        atom tmp_ptr = alloc_bytes_cstr(param)
        integer rc = c_func(fn_easy_setopt_ptr, {curl, opt, tmp_ptr})
        free(tmp_ptr)
        return rc
    end if

    if opt = CURLOPT_POSTFIELDS or opt = CURLOPT_ERRORBUFFER then
        free_handle_opt_alloc(curl, opt)
    end if
    return c_func(fn_easy_setopt_ptr, {curl, opt, param})
end function

public function curl_easy_perform(atom curl)
    return c_func(fn_easy_perform, {curl})
end function

--**
-- Raw version of curl_easy_getinfo: writes the result into a caller-provided C buffer.
public function curl_easy_getinfo_raw(atom curl, integer info, atom out_ptr)
    return c_func(fn_easy_getinfo, {curl, info, out_ptr})
end function

--**
-- Queries transfer information, automatically decoding according to the CURLINFO_* type.
-- Returns {CURLcode, value}. For CURLINFO_SLIST (e.g., COOKIELIST, SSL_ENGINES) converts to
-- a sequence of strings and frees the C list automatically.
public function curl_easy_getinfo(atom curl, integer info)
    atom buf = allocate(8)
    poke8(buf, 0)

    integer rc = c_func(fn_easy_getinfo, {curl, info, buf})
    if rc != CURLE_OK then
        free(buf)
        return {rc, 0}
    end if

    integer typ = and_bits(info, CURLINFO_TYPEMASK)
    object val = 0

    switch typ do
        case CURLINFO_STRING then
            val = read_opt_cstr(peek_pointer(buf))
        case CURLINFO_LONG then
            val = peek_longs(buf)
        case CURLINFO_DOUBLE then
            val = float64_to_atom(peek({buf, 8}))
        case CURLINFO_SLIST then
            atom p = peek_pointer(buf)
            if info = CURLINFO_SSL_ENGINES or info = CURLINFO_COOKIELIST then
                val = curl_slist_to_sequence(p)
                curl_slist_free_all(p)
            else
                val = p
            end if
        case CURLINFO_SOCKET then
            val = peek_pointer(buf)
        case CURLINFO_OFF_T then
            val = peek8s(buf)
        case else
            val = peek_pointer(buf)
    end switch

    free(buf)
    return {rc, val}
end function

public function curl_easy_pause(atom curl, integer bitmask)
    return c_func(fn_easy_pause, {curl, bitmask})
end function

public function curl_easy_escape(atom curl, sequence text)
    integer n = length(text)
    if n = 0 then
        return ""
    end if
    atom in_ptr = allocate(n)
    poke(in_ptr, text)
    atom ret_ptr = c_func(fn_easy_escape, {curl, in_ptr, n})
    free(in_ptr)
    if ret_ptr = 0 then
        return ""
    end if
    sequence res = peek_string(ret_ptr)
    curl_free(ret_ptr)
    return res
end function

public function curl_easy_unescape(atom curl, sequence text)
    integer n = length(text)
    if n = 0 then
        return ""
    end if
    atom in_ptr = allocate(n)
    poke(in_ptr, text)
    atom outlen_ptr = allocate(4)
    poke4(outlen_ptr, 0)

    atom ret_ptr = c_func(fn_easy_unescape, {curl, in_ptr, n, outlen_ptr})
    free(in_ptr)

    integer outlen = peek4s(outlen_ptr)
    free(outlen_ptr)

    if ret_ptr = 0 then
        return ""
    end if
    sequence res = ""
    if outlen > 0 then
        res = peek({ret_ptr, outlen})
    end if
    curl_free(ret_ptr)
    return res
end function

--**
-- Receives raw bytes from a socket connected with CURLOPT_CONNECT_ONLY.
-- Returns {CURLcode, received_bytes_sequence}.
public function curl_easy_recv(atom curl, integer max_len = 16384)
    if max_len <= 0 then
        return {CURLE_BAD_FUNCTION_ARGUMENT, ""}
    end if
    atom buf = allocate(max_len)
    atom n_ptr = allocate(PTR_SIZE)
    poke_pointer(n_ptr, 0)

    integer rc = c_func(fn_easy_recv, {curl, buf, max_len, n_ptr})
    atom nread = peek_pointer(n_ptr)
    free(n_ptr)

    sequence data = ""
    if rc = CURLE_OK and nread > 0 then
        data = peek({buf, nread})
    end if
    free(buf)
    return {rc, data}
end function

--**
-- Sends raw bytes over a socket connected with CURLOPT_CONNECT_ONLY.
-- Returns {CURLcode, bytes_sent}.
public function curl_easy_send(atom curl, sequence data)
    integer n = length(data)
    atom buf = 0
    if n > 0 then
        buf = allocate(n)
        poke(buf, data)
    else
        buf = allocate(1)
        poke(buf, 0)
    end if
    atom n_ptr = allocate(PTR_SIZE)
    poke_pointer(n_ptr, 0)

    integer rc = c_func(fn_easy_send, {curl, buf, n, n_ptr})
    atom nsent = peek_pointer(n_ptr)
    free(n_ptr)
    free(buf)
    return {rc, nsent}
end function

public function curl_easy_strerror(integer err_code)
    return read_opt_cstr(c_func(fn_easy_strerror, {err_code}))
end function

public function curl_easy_upkeep(atom curl)
    return c_func(fn_easy_upkeep, {curl})
end function

public function curl_easy_ssls_export(atom curl, atom export_cb, atom userptr = 0)
    return c_func(fn_easy_ssls_export, {curl, export_cb, userptr})
end function

public function curl_easy_ssls_import(atom curl, sequence session_key,
        sequence shmac, sequence sdata)
    atom key_ptr = allocate_string(session_key)
    integer hmac_len = length(shmac)
    integer data_len = length(sdata)
    atom hmac_ptr = 0
    atom data_ptr = 0
    if hmac_len > 0 then
        hmac_ptr = allocate(hmac_len)
        poke(hmac_ptr, shmac)
    end if
    if data_len > 0 then
        data_ptr = allocate(data_len)
        poke(data_ptr, sdata)
    end if
    integer rc = c_func(fn_easy_ssls_import, {curl, key_ptr, hmac_ptr, hmac_len, data_ptr, data_len})
    free(key_ptr)
    if hmac_ptr != 0 then
        free(hmac_ptr)
    end if
    if data_ptr != 0 then
        free(data_ptr)
    end if
    return rc
end function

-- =============================================================================
-- 4. Easy Options Introspection & Header API (5 functions)
-- =============================================================================

constant
    fn_easy_option_by_id   = cdecl_link_func("curl_easy_option_by_id", {C_INT}, C_POINTER),
    fn_easy_option_by_name = cdecl_link_func("curl_easy_option_by_name", {C_POINTER}, C_POINTER),
    fn_easy_option_next    = cdecl_link_func("curl_easy_option_next", {C_POINTER}, C_POINTER),
    fn_easy_header         = cdecl_link_func("curl_easy_header",
        {C_POINTER, C_POINTER, C_POINTER, C_UINT, C_INT, C_POINTER}, C_INT),
    fn_easy_nextheader     = cdecl_link_func("curl_easy_nextheader",
        {C_POINTER, C_UINT, C_INT, C_POINTER}, C_POINTER)

function decode_easyoption(atom p)
    if p = 0 then
        return {}
    end if
    sequence name = read_opt_cstr(peek_pointer(p))
    integer id    = peek4s(p + PTR_SIZE)
    integer typ   = peek4s(p + PTR_SIZE + 4)
    atom flags    = peek4u(p + PTR_SIZE + 8)
    return {name, id, typ, flags, p}
end function

public function curl_easy_option_by_id(integer id)
    return decode_easyoption(c_func(fn_easy_option_by_id, {id}))
end function

public function curl_easy_option_by_name(sequence name)
    atom np = allocate_string(name)
    atom p = c_func(fn_easy_option_by_name, {np})
    free(np)
    return decode_easyoption(p)
end function

--**
-- Iterates over libcurl options. Pass 0 (or the previous sequence) to start/continue.
-- Returns {} at the end of iteration.
public function curl_easy_option_next(object prev = 0)
    atom prev_ptr = 0
    if sequence(prev) then
        if length(prev) >= EOPT_RAW_PTR then
            prev_ptr = prev[EOPT_RAW_PTR]
        end if
    else
        prev_ptr = prev
    end if
    return decode_easyoption(c_func(fn_easy_option_next, {prev_ptr}))
end function

function decode_header_struct(atom p)
    if p = 0 then
        return {}
    end if
    sequence name  = read_opt_cstr(peek_pointer(p))
    sequence value = read_opt_cstr(peek_pointer(p + PTR_SIZE))
    atom amount    = peek_pointer(p + PTR_SIZE * 2)
    atom idx       = peek_pointer(p + PTR_SIZE * 3)
    atom origin    = peek4u(p + PTR_SIZE * 4)
    atom anchor    = 0
    ifdef BITS64 then
        anchor = peek_pointer(p + 40)
    elsedef
        anchor = peek_pointer(p + 20)
    end ifdef
    return {name, value, amount, idx, origin, anchor, p}
end function

--**
-- Queries a specific HTTP header received by the handle.
-- Returns {CURLHcode, {name, value, amount, index, origin, anchor, raw_ptr}} or {CURLHcode, {}}.
public function curl_easy_header(atom curl, sequence name, atom index = 0,
        atom origin = CURLH_HEADER, integer request = -1)
    atom np = allocate_string(name)
    atom hout_pp = allocate(PTR_SIZE)
    poke_pointer(hout_pp, 0)

    integer rc = c_func(fn_easy_header, {curl, np, index, origin, request, hout_pp})
    free(np)

    atom hptr = peek_pointer(hout_pp)
    free(hout_pp)

    if rc != CURLHE_OK or hptr = 0 then
        return {rc, {}}
    end if
    return {rc, decode_header_struct(hptr)}
end function

--**
-- Iterates over headers received by the handle. Pass 0 (or the previous return value) as prev.
public function curl_easy_nextheader(atom curl, atom origin = CURLH_HEADER,
        integer request = -1, object prev = 0)
    atom prev_ptr = 0
    if sequence(prev) then
        if length(prev) >= HDR_RAW_PTR then
            prev_ptr = prev[HDR_RAW_PTR]
        end if
    else
        prev_ptr = prev
    end if
    return decode_header_struct(c_func(fn_easy_nextheader, {curl, origin, request, prev_ptr}))
end function

