    atom p = allocate_string(mimetype)
    integer rc = c_func(fn_mime_type, {part, p})
    free(p)
    return rc
end function

public function curl_mime_encoder(atom part, object encoding)
    if atom(encoding) and encoding = 0 then
        return c_func(fn_mime_encoder, {part, 0})
    end if
    atom p = allocate_string(encoding)
    integer rc = c_func(fn_mime_encoder, {part, p})
