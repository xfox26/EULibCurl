constant
    fn_multi_init           = cdecl_link_func("curl_multi_init", {}, C_POINTER),
    fn_multi_cleanup        = cdecl_link_func("curl_multi_cleanup", {C_POINTER}, C_INT),
    fn_multi_add_handle     = cdecl_link_func("curl_multi_add_handle", {C_POINTER, C_POINTER}, C_INT),
    fn_multi_remove_handle  = cdecl_link_func("curl_multi_remove_handle", {C_POINTER, C_POINTER}, C_INT),
    fn_multi_perform        = cdecl_link_func("curl_multi_perform", {C_POINTER, C_POINTER}, C_INT),
    fn_multi_wait           = cdecl_link_func("curl_multi_wait",
        {C_POINTER, C_POINTER, C_UINT, C_INT, C_POINTER}, C_INT),
    fn_multi_poll           = cdecl_link_func("curl_multi_poll",
        {C_POINTER, C_POINTER, C_UINT, C_INT, C_POINTER}, C_INT),
    fn_multi_waitfds        = cdecl_link_func("curl_multi_waitfds",
        {C_POINTER, C_POINTER, C_UINT, C_POINTER}, C_INT),
    fn_multi_wakeup         = cdecl_link_func("curl_multi_wakeup", {C_POINTER}, C_INT),
    fn_multi_info_read      = cdecl_link_func("curl_multi_info_read", {C_POINTER, C_POINTER}, C_POINTER),
    fn_multi_setopt_long    = cdecl_link_func("curl_multi_setopt", {C_POINTER, C_INT, C_LONG}, C_INT),
    fn_multi_setopt_ptr     = cdecl_link_func("curl_multi_setopt", {C_POINTER, C_INT, C_POINTER}, C_INT),
    fn_multi_setopt_offt    = cdecl_link_func("curl_multi_setopt", {C_POINTER, C_INT, C_LONGLONG}, C_INT),
    fn_multi_timeout        = cdecl_link_func("curl_multi_timeout", {C_POINTER, C_POINTER}, C_INT),
    fn_multi_fdset          = cdecl_link_func("curl_multi_fdset",
        {C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_multi_socket         = cdecl_link_func("curl_multi_socket",
        {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_multi_socket_action  = cdecl_link_func("curl_multi_socket_action",
        {C_POINTER, C_POINTER, C_INT, C_POINTER}, C_INT),
    fn_multi_socket_all     = cdecl_link_func("curl_multi_socket_all", {C_POINTER, C_POINTER}, C_INT),
    fn_multi_assign         = cdecl_link_func("curl_multi_assign", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_multi_strerror       = cdecl_link_func("curl_multi_strerror", {C_INT}, C_POINTER),
    fn_multi_get_handles    = cdecl_link_func("curl_multi_get_handles", {C_POINTER}, C_POINTER)

public function curl_multi_init()
    return c_func(fn_multi_init, {})
end function

public function curl_multi_cleanup(atom multi)
    if multi = 0 then
        return CURLM_BAD_HANDLE
    end if
    return c_func(fn_multi_cleanup, {multi})
end function

public function curl_multi_add_handle(atom multi, atom easy)
    return c_func(fn_multi_add_handle, {multi, easy})
end function

public function curl_multi_remove_handle(atom multi, atom easy)
    return c_func(fn_multi_remove_handle, {multi, easy})
end function

--**
-- Performs pending transfer steps on handles in the multi-handle without blocking.
-- Returns {CURLMcode, running_handles}.
public function curl_multi_perform(atom multi)
    atom rp = allocate(4)
    poke4(rp, 0)
    integer rc = c_func(fn_multi_perform, {multi, rp})
    integer running = peek4s(rp)
    free(rp)
    return {rc, running}
end function

--**
-- Waits for activity on multi-managed sockets (returns immediately if extra_fds and sockets
-- are not ready after timeout_ms). Returns {CURLMcode, numfds}.
public function curl_multi_wait(atom multi, integer timeout_ms = 50,
        atom extra_fds = 0, integer extra_nfds = 0)
    atom nfds_ptr = allocate(4)
    poke4(nfds_ptr, 0)
    integer rc = c_func(fn_multi_wait, {multi, extra_fds, extra_nfds, timeout_ms, nfds_ptr})
    integer numfds = peek4s(nfds_ptr)
    free(nfds_ptr)
    return {rc, numfds}
end function

--**
-- Waits for socket activity or curl_multi_wakeup() for up to timeout_ms.
-- Returns {CURLMcode, numfds}.
public function curl_multi_poll(atom multi, integer timeout_ms = 50,
        atom extra_fds = 0, integer extra_nfds = 0)
    atom nfds_ptr = allocate(4)
    poke4(nfds_ptr, 0)
    integer rc = c_func(fn_multi_poll, {multi, extra_fds, extra_nfds, timeout_ms, nfds_ptr})
    integer numfds = peek4s(nfds_ptr)
    free(nfds_ptr)
    return {rc, numfds}
end function

--**
-- Queries the socket descriptors of the multi handle.
-- Returns {CURLMcode, fd_count} where ufds points to a caller-allocated buffer (or 0).
public function curl_multi_waitfds(atom multi, atom ufds_ptr = 0, integer ufds_size = 0)
    atom count_ptr = allocate(4)
    poke4(count_ptr, 0)
    integer rc = c_func(fn_multi_waitfds, {multi, ufds_ptr, ufds_size, count_ptr})
    atom count = peek4u(count_ptr)
    free(count_ptr)
    return {rc, count}
end function

public function curl_multi_wakeup(atom multi)
    return c_func(fn_multi_wakeup, {multi})
end function

--**
-- Reads the next CURLMsg message from the multi handle queue.
-- Returns {} if no messages are available, or {msg, easy_handle, result, msgs_in_queue}.
public function curl_multi_info_read(atom multi)
    atom q_ptr = allocate(4)
    poke4(q_ptr, 0)
    atom msg_ptr = c_func(fn_multi_info_read, {multi, q_ptr})
    integer queued = peek4s(q_ptr)
    free(q_ptr)

    if msg_ptr = 0 then
        return {}
    end if

    integer msg_type = peek4s(msg_ptr)
    atom easy_handle = peek_pointer(msg_ptr + PTR_SIZE)
    integer result   = peek4s(msg_ptr + PTR_SIZE * 2)
    return {msg_type, easy_handle, result, queued}
end function

public function curl_multi_setopt(atom multi, integer opt, object param)
    if opt >= 30000 and opt < 40000 then
        return c_func(fn_multi_setopt_offt, {multi, opt, param})
    elsif opt < 10000 then
        return c_func(fn_multi_setopt_long, {multi, opt, param})
    else
        if sequence(param) then
            atom p = alloc_bytes_cstr(param)
            integer rc = c_func(fn_multi_setopt_ptr, {multi, opt, p})
            free(p)
            return rc
        end if
        return c_func(fn_multi_setopt_ptr, {multi, opt, param})
    end if
end function

public function curl_multi_timeout(atom multi)
    atom tp = allocate(PTR_SIZE)
    poke_long(tp, -1)
    integer rc = c_func(fn_multi_timeout, {multi, tp})
    atom timeout_ms = peek_longs(tp)
    free(tp)
    return {rc, timeout_ms}
end function

public function curl_multi_fdset(atom multi, atom read_fd_set, atom write_fd_set, atom exc_fd_set)
    atom maxfd_ptr = allocate(4)
    poke4(maxfd_ptr, -1)
    integer rc = c_func(fn_multi_fdset, {multi, read_fd_set, write_fd_set, exc_fd_set, maxfd_ptr})
    integer maxfd = peek4s(maxfd_ptr)
    free(maxfd_ptr)
    return {rc, maxfd}
end function

public function curl_multi_socket(atom multi, atom sock)
    atom rp = allocate(4)
    poke4(rp, 0)
    integer rc = c_func(fn_multi_socket, {multi, sock, rp})
    integer running = peek4s(rp)
    free(rp)
    return {rc, running}
end function

public function curl_multi_socket_action(atom multi, atom sock, integer ev_bitmask)
    atom rp = allocate(4)
    poke4(rp, 0)
    integer rc = c_func(fn_multi_socket_action, {multi, sock, ev_bitmask, rp})
    integer running = peek4s(rp)
    free(rp)
    return {rc, running}
end function

public function curl_multi_socket_all(atom multi)
    atom rp = allocate(4)
    poke4(rp, 0)
    integer rc = c_func(fn_multi_socket_all, {multi, rp})
    integer running = peek4s(rp)
    free(rp)
    return {rc, running}
end function

public function curl_multi_assign(atom multi, atom sock, atom sockptr)
    return c_func(fn_multi_assign, {multi, sock, sockptr})
end function

public function curl_multi_strerror(integer err_code)
    return read_opt_cstr(c_func(fn_multi_strerror, {err_code}))
end function

--**
-- Returns all easy handles currently attached to the multi handle (and frees the internal C array).
public function curl_multi_get_handles(atom multi)
    atom arr = c_func(fn_multi_get_handles, {multi})
    if arr = 0 then
        return {}
    end if
    sequence handles = {}
    atom cur = arr
    atom eh = peek_pointer(cur)
    while eh != 0 do
        handles = append(handles, eh)
        cur += PTR_SIZE
        eh = peek_pointer(cur)
    end while
    curl_free(arr)
    return handles
end function

