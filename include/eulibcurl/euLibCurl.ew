-- 10. HTTP/2 Server Push Headers (2 functions)
-- =============================================================================

constant
    fn_pushheader_bynum  = cdecl_link_func("curl_pushheader_bynum", {C_POINTER, C_POINTER}, C_POINTER),
    fn_pushheader_byname = cdecl_link_func("curl_pushheader_byname", {C_POINTER, C_POINTER}, C_POINTER)

public function curl_pushheader_bynum(atom push_headers, atom num)
    return read_opt_cstr(c_func(fn_pushheader_bynum, {push_headers, num}))
end function

public function curl_pushheader_byname(atom push_headers, sequence name)
    atom np = allocate_string(name)
    atom rp = c_func(fn_pushheader_byname, {push_headers, np})
    free(np)
    return read_opt_cstr(rp)
end function

-- =============================================================================
-- 11. Legacy API (Form & Escape/Unescape) (5 functions)
-- =============================================================================

constant
    pr_formfree = cdecl_link_proc("curl_formfree", {C_POINTER}),
    fn_formget  = cdecl_link_func("curl_formget", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_escape   = cdecl_link_func("curl_escape", {C_POINTER, C_INT}, C_POINTER),
    fn_unescape = cdecl_link_func("curl_unescape", {C_POINTER, C_INT}, C_POINTER)

-- Registers curl_formadd with typed varargs for up to 6 {CURLFORM_*, value} pairs + CURLFORM_END
constant
    fn_formadd_1 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT),
    fn_formadd_2 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT),
    fn_formadd_3 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT),
    fn_formadd_4 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT),
    fn_formadd_5 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT),
    fn_formadd_6 = cdecl_link_func("curl_formadd",
        {C_POINTER, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT, C_POINTER, C_INT}, C_INT)

--**
-- Legacy wrapper for curl_formadd() (prefer curl_mime_* for new code).
-- Accepts {httppost_pp, lastpost_pp} pointers and a list of {{CURLFORM_*, value}, ...} pairs (1..6 pairs).
public function curl_formadd(atom first_pp, atom last_pp, sequence pairs)
    integer npairs = length(pairs)
    if npairs < 1 or npairs > 6 then
        error:crash("curl_formadd supports 1 to 6 {CURLFORM_*, value} pairs (got %d)", {npairs})
    end if

    sequence c_args = {first_pp, last_pp}
    sequence tmp_allocs = {}

    for i = 1 to npairs do
        integer opt_code = pairs[i][1]
        object val = pairs[i][2]
        c_args = append(c_args, opt_code)
        if sequence(val) then
            atom sp = alloc_bytes_cstr(val)
            tmp_allocs = append(tmp_allocs, sp)
            c_args = append(c_args, sp)
        else
            c_args = append(c_args, val)
        end if
    end for
    c_args = append(c_args, CURLFORM_END)

    integer rc = CURL_FORMADD_UNKNOWN_OPTION
    switch npairs do
        case 1 then rc = c_func(fn_formadd_1, c_args)
        case 2 then rc = c_func(fn_formadd_2, c_args)
        case 3 then rc = c_func(fn_formadd_3, c_args)
        case 4 then rc = c_func(fn_formadd_4, c_args)
        case 5 then rc = c_func(fn_formadd_5, c_args)
        case 6 then rc = c_func(fn_formadd_6, c_args)
        case else rc = CURL_FORMADD_UNKNOWN_OPTION
    end switch

    for i = 1 to length(tmp_allocs) do
        free(tmp_allocs[i])
    end for
    return rc
end function

public procedure curl_formfree(atom form)
    if form != 0 then
        c_proc(pr_formfree, {form})
    end if
end procedure

public function curl_formget(atom form, atom arg, atom append_cb)
    return c_func(fn_formget, {form, arg, append_cb})
end function

public function curl_escape(sequence text)
    integer n = length(text)
    if n = 0 then
        return ""
    end if
    atom sp = allocate(n)
    poke(sp, text)
    atom rp = c_func(fn_escape, {sp, n})
    free(sp)
    if rp = 0 then
        return ""
    end if
    sequence res = peek_string(rp)
    curl_free(rp)
    return res
end function

public function curl_unescape(sequence text)
    integer n = length(text)
    if n = 0 then
        return ""
    end if
    atom sp = allocate(n)
    poke(sp, text)
    atom rp = c_func(fn_unescape, {sp, n})
    free(sp)
    if rp = 0 then
        return ""
    end if
    sequence res = peek_string(rp)
    curl_free(rp)
    return res
end function

-- =============================================================================
-- 12. curl_m*printf Family (10 functions)
--     Note: for formatting in Euphoria, prefer native printf() / sprintf().
-- =============================================================================

constant
    fn_mprintf     = cdecl_link_func("curl_mprintf", {C_POINTER, C_POINTER}, C_INT),
    fn_mfprintf    = cdecl_link_func("curl_mfprintf", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_msprintf    = cdecl_link_func("curl_msprintf", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_msnprintf   = cdecl_link_func("curl_msnprintf", {C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_maprintf    = cdecl_link_func("curl_maprintf", {C_POINTER, C_POINTER}, C_POINTER),
    fn_mvprintf    = cdecl_link_func("curl_mvprintf", {C_POINTER, C_POINTER}, C_INT),
    fn_mvfprintf   = cdecl_link_func("curl_mvfprintf", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_mvsprintf   = cdecl_link_func("curl_mvsprintf", {C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_mvsnprintf  = cdecl_link_func("curl_mvsnprintf", {C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_mvaprintf   = cdecl_link_func("curl_mvaprintf", {C_POINTER, C_POINTER}, C_POINTER)

constant FMT_STR_PTR = allocate_string("%s")

public function curl_mprintf(sequence text)
    atom tp = allocate_string(text)
    integer rc = c_func(fn_mprintf, {FMT_STR_PTR, tp})
    free(tp)
    return rc
end function

public function curl_mfprintf(atom c_file_ptr, sequence text)
    atom tp = allocate_string(text)
    integer rc = c_func(fn_mfprintf, {c_file_ptr, FMT_STR_PTR, tp})
    free(tp)
    return rc
end function

public function curl_msprintf(atom out_buf, sequence text)
    atom tp = allocate_string(text)
    integer rc = c_func(fn_msprintf, {out_buf, FMT_STR_PTR, tp})
    free(tp)
    return rc
end function

public function curl_msnprintf(atom out_buf, atom max_len, sequence text)
    atom tp = allocate_string(text)
    integer rc = c_func(fn_msnprintf, {out_buf, max_len, FMT_STR_PTR, tp})
    free(tp)
