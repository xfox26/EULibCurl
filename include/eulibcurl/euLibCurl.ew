-- =============================================================================
-- euLibCurl.ew - Complete libcurl 8.15.0 wrapper for OpenEuphoria 4.1+
--
-- Covers 100% of all 96 exported functions in libcurl-x32.dll / libcurl-x64.dll
-- (v8.15.0_5), with proper Windows cdecl callbacks, per-handle memory tracking,
-- 64-bit option support (curl_off_t), blobs, headers, URL API,
-- MIME, Share, Multi, and WebSockets.
-- =============================================================================

namespace curl

public include eulibcurl/curl_constants.e

include std/convert.e
include std/dll.e
include std/error.e
include std/machine.e
include std/map.e
include std/types.e

-- =============================================================================
-- Architecture configuration, DLL loading, and cdecl linking
-- =============================================================================

constant PTR_SIZE = sizeof(C_POINTER)
constant SIZEOF_CURL_BLOB = PTR_SIZE * 3

ifdef BITS64 then
    constant LIBCURL_DLL_NAME = "libcurl-x64.dll"
    constant LIBCURL_DLL_CANDIDATES = {"bin/libcurl-x64.dll", "libcurl-x64.dll"}
elsedef
    ifdef WINDOWS then
        constant LIBCURL_DLL_NAME = "libcurl-x32.dll"
        constant LIBCURL_DLL_CANDIDATES = {"bin/libcurl-x32.dll", "libcurl-x32.dll"}
    elsedef
        constant LIBCURL_DLL_NAME = "libcurl.so.4"
        constant LIBCURL_DLL_CANDIDATES = {"libcurl.so.4", "libcurl.so"}
    end ifdef
end ifdef

constant LibCurlLib = open_dll(LIBCURL_DLL_CANDIDATES)
if LibCurlLib = 0 then
    error:crash("Unable to load shared library %s", {LIBCURL_DLL_NAME})
end if

sequence linked_symbol_names = {}

function cdecl_link_func(sequence name, sequence args, atom ret_type)
    sequence sym = name
    ifdef WINDOWS then
        sym = "+" & name
    end ifdef
    integer rid = define_c_func(LibCurlLib, sym, args, ret_type)
    if rid = -1 then
        error:crash("Failed to link C function '%s' in %s", {name, LIBCURL_DLL_NAME})
    end if
    if not find(name, linked_symbol_names) then
        linked_symbol_names = append(linked_symbol_names, name)
    end if
    return rid
end function

function cdecl_link_proc(sequence name, sequence args)
    sequence sym = name
    ifdef WINDOWS then
        sym = "+" & name
    end ifdef
    integer rid = define_c_proc(LibCurlLib, sym, args)
    if rid = -1 then
        error:crash("Failed to link C procedure '%s' in %s", {name, LIBCURL_DLL_NAME})
    end if
    if not find(name, linked_symbol_names) then
        linked_symbol_names = append(linked_symbol_names, name)
    end if
    return rid
end function

--**
-- Returns the native handle (atom) returned by open_dll() for the loaded libcurl library.
public function curl_dll_handle()
    return LibCurlLib
end function

--**
-- Returns the number of DLL functions/procedures linked by this wrapper.
public function curl_linked_count()
    return length(linked_symbol_names)
end function

--**
-- Returns a sequence containing the exact names of all linked C symbols.
public function curl_linked_names()
    return linked_symbol_names
end function

--**
-- Creates a C callback pointer compatible with libcurl's cdecl calling convention.
-- Uses {'+', rid} on Windows and rid directly on Unix platforms.
public function curl_callback(integer rid)
    if rid < 0 then
        error:crash("Invalid routine_id (%d) passed to curl_callback()", {rid})
    end if
    ifdef WINDOWS then
        return call_back({'+', rid})
    elsedef
        return call_back(rid)
    end ifdef
end function

function read_opt_cstr(atom ptr)
    if ptr = 0 then
        return ""
    end if
    return peek_string(ptr)
end function

function alloc_bytes_cstr(sequence data)
    integer n = length(data)
    atom ptr = allocate(n + 1)
    if n > 0 then
        poke(ptr, data)
    end if
    poke(ptr + n, 0)
    return ptr
end function

function read_cstr_array(atom arr_ptr)
    sequence out = {}
    if arr_ptr = 0 then
        return out
    end if
    atom cur = arr_ptr
    atom item_ptr = peek_pointer(cur)
    while item_ptr != 0 do
        out = append(out, peek_string(item_ptr))
        cur += PTR_SIZE
        item_ptr = peek_pointer(cur)
    end while
    return out
end function

-- =============================================================================
-- Structured enums for composite return values
-- =============================================================================

-- Fields returned by curl_version_info()
public enum
    VI_AGE = 1,
    VI_VERSION,
    VI_VERSION_NUM,
    VI_HOST,
    VI_FEATURES,
    VI_SSL_VERSION,
    VI_SSL_VERSION_NUM,
    VI_LIBZ_VERSION,
    VI_PROTOCOLS,
    VI_ARES,
    VI_ARES_NUM,
    VI_LIBIDN,
    VI_ICONV_VER_NUM,
    VI_LIBSSH_VERSION,
    VI_BROTLI_VER_NUM,
    VI_BROTLI_VERSION,
    VI_NGHTTP2_VER_NUM,
    VI_NGHTTP2_VERSION,
    VI_QUIC_VERSION,
    VI_CAINFO,
    VI_CAPATH,
    VI_ZSTD_VER_NUM,
    VI_ZSTD_VERSION,
    VI_HYPER_VERSION,
    VI_GSASL_VERSION,
    VI_FEATURE_NAMES,
    VI_RTMP_VERSION

-- Fields returned by curl_easy_option_*()
public enum
    EOPT_NAME = 1,
    EOPT_ID,
    EOPT_TYPE,
    EOPT_FLAGS,
    EOPT_RAW_PTR

-- Fields returned by curl_easy_header() / curl_easy_nextheader()
public enum
    HDR_NAME = 1,
    HDR_VALUE,
    HDR_AMOUNT,
    HDR_INDEX,
    HDR_ORIGIN,
    HDR_ANCHOR,
    HDR_RAW_PTR

-- Fields returned by curl_multi_info_read()
public enum
    MMSG_MSG = 1,
    MMSG_EASY_HANDLE,
    MMSG_RESULT,
    MMSG_QUEUED

-- Metadata fields returned by curl_ws_recv() / curl_ws_meta()
public enum
    WS_AGE = 1,
    WS_FLAGS,
    WS_OFFSET,
    WS_BYTESLEFT,
    WS_LEN

-- =============================================================================
-- Per-Easy-Handle allocation management
-- =============================================================================

map handle_allocs = map:new()

procedure free_handle_opt_alloc(atom curl, integer opt)
    object sub = map:get(handle_allocs, curl, 0)
    if map:map(sub) and map:has(sub, opt) then
        atom old_ptr = map:get(sub, opt, 0)
        if old_ptr != 0 then
            free(old_ptr)
        end if
        map:remove(sub, opt)
    end if
end procedure

procedure set_handle_opt_alloc(atom curl, integer opt, atom ptr)
    object sub = map:get(handle_allocs, curl, 0)
    if not map:map(sub) then
        sub = map:new()
        map:put(handle_allocs, curl, sub)
    end if
    if map:has(sub, opt) then
        atom old_ptr = map:get(sub, opt, 0)
        if old_ptr != 0 then
            free(old_ptr)
        end if
    end if
    map:put(sub, opt, ptr)
end procedure

procedure free_all_handle_allocs(atom curl)
    object sub = map:get(handle_allocs, curl, 0)
    if map:map(sub) then
        sequence ks = map:keys(sub)
        for i = 1 to length(ks) do
            atom ptr = map:get(sub, ks[i], 0)
            if ptr != 0 then
                free(ptr)
            end if
        end for
        map:remove(handle_allocs, curl)
    end if
end procedure

-- =============================================================================
-- 1. Global, Version, and Utilities (12 functions)
-- =============================================================================

constant
    fn_global_init     = cdecl_link_func("curl_global_init", {C_LONG}, C_INT),
    fn_global_init_mem = cdecl_link_func("curl_global_init_mem",
        {C_LONG, C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    pr_global_cleanup  = cdecl_link_proc("curl_global_cleanup", {}),
    fn_global_sslset   = cdecl_link_func("curl_global_sslset", {C_INT, C_POINTER, C_POINTER}, C_INT),
    fn_global_trace    = cdecl_link_func("curl_global_trace", {C_POINTER}, C_INT),
    fn_version         = cdecl_link_func("curl_version", {}, C_POINTER),
    fn_version_info    = cdecl_link_func("curl_version_info", {C_INT}, C_POINTER),
    pr_free            = cdecl_link_proc("curl_free", {C_POINTER}),
    fn_getdate         = cdecl_link_func("curl_getdate", {C_POINTER, C_POINTER}, C_LONGLONG),
    fn_getenv          = cdecl_link_func("curl_getenv", {C_POINTER}, C_POINTER),
    fn_strequal        = cdecl_link_func("curl_strequal", {C_POINTER, C_POINTER}, C_INT),
    fn_strnequal       = cdecl_link_func("curl_strnequal", {C_POINTER, C_POINTER, C_POINTER}, C_INT)

public function curl_global_init(atom flags = CURL_GLOBAL_DEFAULT)
    return c_func(fn_global_init, {flags})
end function

public function curl_global_init_mem(atom flags, atom malloc_cb, atom free_cb,
        atom realloc_cb, atom strdup_cb, atom calloc_cb)
    return c_func(fn_global_init_mem, {flags, malloc_cb, free_cb, realloc_cb, strdup_cb, calloc_cb})
end function

public procedure curl_global_cleanup()
    c_proc(pr_global_cleanup, {})
end procedure

--**
-- Selects the SSL backend before curl_global_init() or queries available backends.
-- Returns {CURLsslset_code, backend_list} where each item is {id, name}.
public function curl_global_sslset(integer backend_id = -1, sequence backend_name = "")
    atom name_ptr = 0
    if length(backend_name) > 0 then
        name_ptr = allocate_string(backend_name)
    end if
    atom avail_pp = allocate(PTR_SIZE)
    poke_pointer(avail_pp, 0)

    integer rc = c_func(fn_global_sslset, {backend_id, name_ptr, avail_pp})
    if name_ptr != 0 then
        free(name_ptr)
    end if

    sequence backends = {}
    atom arr = peek_pointer(avail_pp)
    free(avail_pp)

    if arr != 0 then
        atom item_entry = peek_pointer(arr)
        while item_entry != 0 do
            integer bid = peek4s(item_entry)
            atom bname_ptr = peek_pointer(item_entry + PTR_SIZE)
            backends = append(backends, {bid, read_opt_cstr(bname_ptr)})
            arr += PTR_SIZE
            item_entry = peek_pointer(arr)
        end while
    end if

    return {rc, backends}
end function

public function curl_global_trace(sequence config)
    atom cfg_ptr = allocate_string(config)
    integer rc = c_func(fn_global_trace, {cfg_ptr})
    free(cfg_ptr)
    return rc
end function

public function curl_version()
    return read_opt_cstr(c_func(fn_version, {}))
end function

public function curl_version_info_raw(integer age = CURLVERSION_NOW)
    return c_func(fn_version_info, {age})
end function

--**
-- Queries detailed libcurl build information as a structured sequence (indexed by VI_*).
public function curl_version_info(integer age = CURLVERSION_NOW)
    atom vi = c_func(fn_version_info, {age})
    if vi = 0 then
        return {}
    end if

    sequence info = repeat("", VI_RTMP_VERSION)
    info[VI_ARES_NUM]        = 0
    info[VI_ICONV_VER_NUM]   = 0
    info[VI_BROTLI_VER_NUM]  = 0
    info[VI_NGHTTP2_VER_NUM] = 0
    info[VI_ZSTD_VER_NUM]    = 0
    info[VI_PROTOCOLS]       = {}
    info[VI_FEATURE_NAMES]   = {}

    ifdef BITS64 then
        integer st_age = peek4s(vi + 0)
        info[VI_AGE]             = st_age
        info[VI_VERSION]         = read_opt_cstr(peek_pointer(vi + 8))
        info[VI_VERSION_NUM]     = peek4u(vi + 16)
        info[VI_HOST]            = read_opt_cstr(peek_pointer(vi + 24))
        info[VI_FEATURES]        = peek4u(vi + 32)
        info[VI_SSL_VERSION]     = read_opt_cstr(peek_pointer(vi + 40))
        info[VI_SSL_VERSION_NUM] = peek_longs(vi + 48)
        info[VI_LIBZ_VERSION]    = read_opt_cstr(peek_pointer(vi + 56))
        info[VI_PROTOCOLS]       = read_cstr_array(peek_pointer(vi + 64))
        if st_age >= CURLVERSION_SECOND then
            info[VI_ARES]        = read_opt_cstr(peek_pointer(vi + 72))
            info[VI_ARES_NUM]    = peek4s(vi + 80)
        end if
        if st_age >= CURLVERSION_THIRD then
            info[VI_LIBIDN]      = read_opt_cstr(peek_pointer(vi + 88))
        end if
        if st_age >= CURLVERSION_FOURTH then
            info[VI_ICONV_VER_NUM]   = peek4s(vi + 96)
            info[VI_LIBSSH_VERSION]  = read_opt_cstr(peek_pointer(vi + 104))
        end if
        if st_age >= CURLVERSION_FIFTH then
            info[VI_BROTLI_VER_NUM]  = peek4u(vi + 112)
            info[VI_BROTLI_VERSION]  = read_opt_cstr(peek_pointer(vi + 120))
        end if
        if st_age >= CURLVERSION_SIXTH then
            info[VI_NGHTTP2_VER_NUM] = peek4u(vi + 128)
            info[VI_NGHTTP2_VERSION] = read_opt_cstr(peek_pointer(vi + 136))
            info[VI_QUIC_VERSION]    = read_opt_cstr(peek_pointer(vi + 144))
        end if
        if st_age >= CURLVERSION_SEVENTH then
            info[VI_CAINFO]          = read_opt_cstr(peek_pointer(vi + 152))
            info[VI_CAPATH]          = read_opt_cstr(peek_pointer(vi + 160))
        end if
        if st_age >= CURLVERSION_EIGHTH then
            info[VI_ZSTD_VER_NUM]    = peek4u(vi + 168)
            info[VI_ZSTD_VERSION]    = read_opt_cstr(peek_pointer(vi + 176))
        end if
        if st_age >= CURLVERSION_NINTH then
            info[VI_HYPER_VERSION]   = read_opt_cstr(peek_pointer(vi + 184))
        end if
        if st_age >= CURLVERSION_TENTH then
            info[VI_GSASL_VERSION]   = read_opt_cstr(peek_pointer(vi + 192))
        end if
        if st_age >= CURLVERSION_ELEVENTH then
            info[VI_FEATURE_NAMES]   = read_cstr_array(peek_pointer(vi + 200))
        end if
        if st_age >= CURLVERSION_TWELFTH then
            info[VI_RTMP_VERSION]    = read_opt_cstr(peek_pointer(vi + 208))
        end if
    elsedef
        integer st_age = peek4s(vi + 0)
        info[VI_AGE]             = st_age
        info[VI_VERSION]         = read_opt_cstr(peek_pointer(vi + 4))
        info[VI_VERSION_NUM]     = peek4u(vi + 8)
        info[VI_HOST]            = read_opt_cstr(peek_pointer(vi + 12))
        info[VI_FEATURES]        = peek4u(vi + 16)
        info[VI_SSL_VERSION]     = read_opt_cstr(peek_pointer(vi + 20))
        info[VI_SSL_VERSION_NUM] = peek_longs(vi + 24)
        info[VI_LIBZ_VERSION]    = read_opt_cstr(peek_pointer(vi + 28))
        info[VI_PROTOCOLS]       = read_cstr_array(peek_pointer(vi + 32))
        if st_age >= CURLVERSION_SECOND then
            info[VI_ARES]        = read_opt_cstr(peek_pointer(vi + 36))
            info[VI_ARES_NUM]    = peek4s(vi + 40)
        end if
        if st_age >= CURLVERSION_THIRD then
            info[VI_LIBIDN]      = read_opt_cstr(peek_pointer(vi + 44))
        end if
        if st_age >= CURLVERSION_FOURTH then
            info[VI_ICONV_VER_NUM]   = peek4s(vi + 48)
            info[VI_LIBSSH_VERSION]  = read_opt_cstr(peek_pointer(vi + 52))
        end if
        if st_age >= CURLVERSION_FIFTH then
            info[VI_BROTLI_VER_NUM]  = peek4u(vi + 56)
            info[VI_BROTLI_VERSION]  = read_opt_cstr(peek_pointer(vi + 60))
        end if
        if st_age >= CURLVERSION_SIXTH then
            info[VI_NGHTTP2_VER_NUM] = peek4u(vi + 64)
            info[VI_NGHTTP2_VERSION] = read_opt_cstr(peek_pointer(vi + 68))
            info[VI_QUIC_VERSION]    = read_opt_cstr(peek_pointer(vi + 72))
        end if
        if st_age >= CURLVERSION_SEVENTH then
            info[VI_CAINFO]          = read_opt_cstr(peek_pointer(vi + 76))
            info[VI_CAPATH]          = read_opt_cstr(peek_pointer(vi + 80))
        end if
        if st_age >= CURLVERSION_EIGHTH then
            info[VI_ZSTD_VER_NUM]    = peek4u(vi + 84)
            info[VI_ZSTD_VERSION]    = read_opt_cstr(peek_pointer(vi + 88))
        end if
        if st_age >= CURLVERSION_NINTH then
            info[VI_HYPER_VERSION]   = read_opt_cstr(peek_pointer(vi + 92))
        end if
        if st_age >= CURLVERSION_TENTH then
            info[VI_GSASL_VERSION]   = read_opt_cstr(peek_pointer(vi + 96))
        end if
        if st_age >= CURLVERSION_ELEVENTH then
            info[VI_FEATURE_NAMES]   = read_cstr_array(peek_pointer(vi + 100))
        end if
        if st_age >= CURLVERSION_TWELFTH then
            info[VI_RTMP_VERSION]    = read_opt_cstr(peek_pointer(vi + 104))
        end if
    end ifdef

    return info
end function

public procedure curl_free(atom ptr)
    if ptr != 0 then
        c_proc(pr_free, {ptr})
    end if
end procedure

public function curl_getdate(sequence datestr, atom unused_now = 0)
    atom p = allocate_string(datestr)
    atom ts = c_func(fn_getdate, {p, unused_now})
    free(p)
    return ts
end function

public function curl_getenv(sequence name)
    atom np = allocate_string(name)
    atom rp = c_func(fn_getenv, {np})
    free(np)
    if rp = 0 then
        return ""
    end if
    sequence res = peek_string(rp)
    curl_free(rp)
    return res
end function

public function curl_strequal(sequence s1, sequence s2)
    atom p1 = allocate_string(s1)
    atom p2 = allocate_string(s2)
    integer res = c_func(fn_strequal, {p1, p2})
    free(p1)
    free(p2)
    return res
end function

public function curl_strnequal(sequence s1, sequence s2, atom max_len)
    atom p1 = allocate_string(s1)
    atom p2 = allocate_string(s2)
    integer res = c_func(fn_strnequal, {p1, p2, max_len})
    free(p1)
    free(p2)
    return res
end function

-- =============================================================================
-- 2. Slist API (2 C functions + helpers)
-- =============================================================================

constant
    fn_slist_append   = cdecl_link_func("curl_slist_append", {C_POINTER, C_POINTER}, C_POINTER),
    pr_slist_free_all = cdecl_link_proc("curl_slist_free_all", {C_POINTER})

public function curl_slist_append(atom slist, sequence item)
    atom sp = allocate_string(item)
    atom res = c_func(fn_slist_append, {slist, sp})
    free(sp)
    return res
end function

public procedure curl_slist_free_all(atom slist)
    if slist != 0 then
        c_proc(pr_slist_free_all, {slist})
    end if
end procedure

public function curl_slist_from_sequence(sequence items)
    atom slist = 0
    for i = 1 to length(items) do
        atom next_list = curl_slist_append(slist, items[i])
        if next_list = 0 then
            curl_slist_free_all(slist)
            return 0
        end if
        slist = next_list
    end for
    return slist
end function

public function curl_slist_to_sequence(atom slist)
    sequence res = {}
    atom cur = slist
    while cur != 0 do
        res = append(res, read_opt_cstr(peek_pointer(cur)))
        cur = peek_pointer(cur + PTR_SIZE)
    end while
    return res
end function

