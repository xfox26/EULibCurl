public function curl_mime_headers(atom part, atom headers_slist, integer take_ownership = 0)
    return c_func(fn_mime_headers, {part, headers_slist, take_ownership})
end function

public function curl_mime_subparts(atom part, atom subparts_mime)
    return c_func(fn_mime_subparts, {part, subparts_mime})
end function

-- =============================================================================
-- 8. URL API (6 functions)
-- =============================================================================

constant
    fn_url          = cdecl_link_func("curl_url", {}, C_POINTER),
    pr_url_cleanup  = cdecl_link_proc("curl_url_cleanup", {C_POINTER}),
    fn_url_dup      = cdecl_link_func("curl_url_dup", {C_POINTER}, C_POINTER),
    fn_url_get      = cdecl_link_func("curl_url_get", {C_POINTER, C_INT, C_POINTER, C_UINT}, C_INT),
    fn_url_set      = cdecl_link_func("curl_url_set", {C_POINTER, C_INT, C_POINTER, C_UINT}, C_INT),
    fn_url_strerror = cdecl_link_func("curl_url_strerror", {C_INT}, C_POINTER)

public function curl_url()
    return c_func(fn_url, {})
end function

public procedure curl_url_cleanup(atom url_handle)
    if url_handle != 0 then
        c_proc(pr_url_cleanup, {url_handle})
    end if
end procedure

public function curl_url_dup(atom url_handle)
    return c_func(fn_url_dup, {url_handle})
end function

--**
-- Extracts a URL component (CURLUPART_*). Returns {CURLUcode, string_value}.
public function curl_url_get(atom url_handle, integer what, atom flags = 0)
    atom out_pp = allocate(PTR_SIZE)
    poke_pointer(out_pp, 0)
    integer rc = c_func(fn_url_get, {url_handle, what, out_pp, flags})
    atom str_ptr = peek_pointer(out_pp)
    free(out_pp)

    sequence val = ""
    if str_ptr != 0 then
        if rc = CURLUE_OK then
            val = peek_string(str_ptr)
        end if
        curl_free(str_ptr)
    end if
    return {rc, val}
end function

--**
-- Sets a URL component (CURLUPART_*). Pass 0 to clear the part or a string to set it.
public function curl_url_set(atom url_handle, integer what, object part, atom flags = 0)
    if atom(part) and part = 0 then
        return c_func(fn_url_set, {url_handle, what, 0, flags})
    end if
    atom p = allocate_string(part)
    integer rc = c_func(fn_url_set, {url_handle, what, p, flags})
    free(p)
    return rc
end function

public function curl_url_strerror(integer err_code)
    return read_opt_cstr(c_func(fn_url_strerror, {err_code}))
end function

-- =============================================================================
-- 9. WebSockets API (3 functions)
-- =============================================================================

constant
    fn_ws_recv = cdecl_link_func("curl_ws_recv",
        {C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_POINTER}, C_INT),
    fn_ws_send = cdecl_link_func("curl_ws_send",
        {C_POINTER, C_POINTER, C_POINTER, C_POINTER, C_LONGLONG, C_UINT}, C_INT),
    fn_ws_meta = cdecl_link_func("curl_ws_meta", {C_POINTER}, C_POINTER)

function decode_ws_frame(atom p)
    if p = 0 then
        return {}
    end if
    integer age       = peek4s(p + 0)
    integer flags     = peek4s(p + 4)
    atom offset       = peek8s(p + 8)
    atom bytesleft    = peek8s(p + 16)
    atom frame_len    = peek_pointer(p + 24)
    return {age, flags, offset, bytesleft, frame_len}
end function

--**
-- Receives a WebSocket frame on a connection opened with CURLOPT_CONNECT_ONLY = 2.
-- Returns {CURLcode, received_bytes, ws_meta}.
public function curl_ws_recv(atom curl, integer max_len = 65536)
    if max_len <= 0 then
        return {CURLE_BAD_FUNCTION_ARGUMENT, "", {}}
    end if
    atom buf = allocate(max_len)
    atom n_ptr = allocate(PTR_SIZE)
    atom meta_pp = allocate(PTR_SIZE)
    poke_pointer(n_ptr, 0)
    poke_pointer(meta_pp, 0)

    integer rc = c_func(fn_ws_recv, {curl, buf, max_len, n_ptr, meta_pp})
    atom nread = peek_pointer(n_ptr)
    atom meta_ptr = peek_pointer(meta_pp)
    free(n_ptr)
    free(meta_pp)

    sequence data = ""
    if rc = CURLE_OK and nread > 0 then
        data = peek({buf, nread})
    end if
    free(buf)
    return {rc, data, decode_ws_frame(meta_ptr)}
end function

--**
-- Sends WebSocket data. Returns {CURLcode, bytes_sent}.
public function curl_ws_send(atom curl, sequence data, atom flags = CURLWS_TEXT, atom fragsize = 0)
    integer n = length(data)
    atom buf = allocate(n + 1)
    if n > 0 then
        poke(buf, data)
    end if
    poke(buf + n, 0)

    atom sent_ptr = allocate(PTR_SIZE)
    poke_pointer(sent_ptr, 0)

    integer rc = c_func(fn_ws_send, {curl, buf, n, sent_ptr, fragsize, flags})
    atom nsent = peek_pointer(sent_ptr)
    free(sent_ptr)
    free(buf)
    return {rc, nsent}
end function

public function curl_ws_meta(atom curl)
    return decode_ws_frame(c_func(fn_ws_meta, {curl}))
end function

